{
  "Auth": {
    "Authority": "https://your-project.supabase.co/auth/v1",
    "Issuer": "https://your-project.supabase.co/auth/v1",
    "Audience": "authenticated"
  },
  "ReverseProxy": {
    "Routes": {
      "patients": {
        "ClusterId": "patients",
        "Match": { "Path": "/api/patients/{**catch-all}" }
      },
      "appointments": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/appointments/{**catch-all}" }
      },
      "professionals": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/professionals/{**catch-all}" }
      },
      "specialties": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/specialties/{**catch-all}" }
      },
      "locations": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/locations/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "patients": {
        "Destinations": {
          "d1": { "Address": "http://patients-api/" }
        }
      },
      "appointments": {
        "Destinations": {
          "d1": { "Address": "http://appointments-api/" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity-api/" }
        }
      }
    }
  },
  "Bff": {
    "SupabaseUrl": "",
    "SupabaseAnonKey": "",
    "PublicBaseUrl": "http://localhost:5026",
    "EnableDevelopmentAuth": true,
    "OAuthProviders": [ "google" ],
    "DevelopmentMemberships": [
      {
        "TenantId": "11111111-1111-1111-1111-111111111111",
        "TenantName": "Demo Clinic",
        "Role": "admin"
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5191",
      "https://localhost:7069"
    ]
  },
  "InternalGateway": {
    "SharedSecret": "dev-internal-gateway-secret"
  },
  "TenantAccess": {
    "Users": [
      {
        "SubjectId": "bootstrap-admin",
        "Email": "admin@healthtech.local",
        "Memberships": [
          {
            "TenantId": "11111111-1111-1111-1111-111111111111",
            "TenantName": "Demo Clinic",
            "Role": "admin",
            "Enabled": true
          }
        ]
      }
    ]
  }
}
