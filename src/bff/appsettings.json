{
  "Auth": {
    "Authority": "",
    "Issuer": "",
    "Audience": "authenticated"
  },
  "ReverseProxy": {
    "Routes": {
      "patients": {
        "ClusterId": "patients",
        "Match": { "Path": "/api/patients/{**catch-all}" }
      },
      "appointments": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/appointments/{**catch-all}" }
      },
      "professionals": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/professionals/{**catch-all}" }
      },
      "specialties": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/specialties/{**catch-all}" }
      },
      "locations": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/locations/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "patients": {
        "Destinations": { "d1": { "Address": "http://patients-api/" } }
      },
      "appointments": {
        "Destinations": { "d1": { "Address": "http://appointments-api/" } }
      },
      "identity": {
        "Destinations": { "d1": { "Address": "http://identity-api/" } }
      }
    }
  },
  "Bff": {
    "SupabaseUrl": "",
    "SupabaseAnonKey": "",
    "PublicBaseUrl": "",
    "EnableDevelopmentAuth": false,
    "OAuthProviders": [ "google" ],
    "DevelopmentMemberships": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "TenantAccess": {
    "Users": []
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
