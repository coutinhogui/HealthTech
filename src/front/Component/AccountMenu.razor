@using Microsoft.AspNetCore.Components.Authorization
@using HealthTech.Front.Services
@inject BffAuthService Auth
@implements IDisposable

<div class="account-trigger-wrap" @onclick:stopPropagation="true">
    <MudIconButton OnClick="Toggle"
                   Size="Size.Small"
                   Class="account-trigger">
        @if (!string.IsNullOrEmpty(Auth.AvatarUrl))
        {
            <MudAvatar Size="Size.Medium">
                <MudImage Src="@Auth.AvatarUrl" Alt="@Auth.DisplayName" Elevation="0" />
            </MudAvatar>
        }
        else
        {
            <div class="account-trigger__guest">
                <MudText Typo="Typo.caption">Conta</MudText>
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Medium" />
            </div>
        }
    </MudIconButton>
</div>

@if (_open)
{
    <MudOverlay Visible="_open"
                AutoClose="true"
                OnClosed="Close"
                DarkBackground="false"
                LockScroll="false"
                ZIndex="1402"
                Class="account-clickaway" />
}

<MudPopover Open="_open"
            AnchorOrigin="Origin.TopRight"
            TransformOrigin="Origin.BottomRight"
            Class="account-popover">
    <div @onclick:stopPropagation="true">
        <AuthorizeView Context="authState">
            <Authorized>
                <MudPaper Elevation="0" Class="account-card">
                    <div class="header">
                        <MudAvatar Size="Size.Medium">
                            <MudImage Src="@Auth.AvatarUrl" Alt="@Auth.DisplayName" Elevation="0" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2">@(string.IsNullOrWhiteSpace(Auth.DisplayName) ? "Profissional" : Auth.DisplayName)</MudText>
                        <MudText Color="Color.Secondary" Typo="Typo.caption">@Auth.CurrentUser?.Email</MudText>
                        <MudText Color="Color.Secondary" Typo="Typo.caption">@(Auth.ActiveTenant?.TenantName ?? "Clinica nao selecionada")</MudText>
                    </div>

                    <MudDivider Class="my-2" />

                    @if (Auth.Memberships.Count > 1)
                    {
                        <MudText Typo="Typo.overline">Clinica ativa</MudText>
                        <MudStack Spacing="1" Class="mb-2">
                            @foreach (var tenant in Auth.Memberships)
                            {
                                <MudButton Variant="@(Auth.ActiveTenant?.TenantId == tenant.TenantId ? Variant.Filled : Variant.Outlined)"
                                           Color="@(Auth.ActiveTenant?.TenantId == tenant.TenantId ? Color.Primary : Color.Default)"
                                           Class="w-100"
                                           StartIcon="@Icons.Material.Filled.Business"
                                           Disabled="@selectingTenant"
                                           OnClick="@(() => SelectTenant(tenant.TenantId))">
                                    @tenant.TenantName
                                </MudButton>
                            }
                        </MudStack>
                        <MudDivider Class="my-2" />
                    }

                    <MudStack Spacing="1">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Class="w-100"
                                   StartIcon="@Icons.Material.Filled.Badge"
                                   Href="/">
                            Perfil
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Class="w-100"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   Disabled="@(Auth.CurrentUser is null)"
                                   OnClick="@SignOutAll">
                            Sair
                        </MudButton>
                    </MudStack>

                    <MudDivider Class="my-2" />

                    <div class="footer">
                        <MudLink Href="/" Underline="Underline.Hover">Ajuda</MudLink>
                        <MudText>·</MudText>
                        <MudLink Href="/" Underline="Underline.Hover">Suporte</MudLink>
                    </div>
                </MudPaper>
            </Authorized>
            <NotAuthorized>
                <MudPaper Elevation="0" Class="account-card account-card--guest">
                    <MudText Typo="Typo.subtitle2">Acesse sua conta</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Entre para continuar de onde parou.
                    </MudText>

                    <MudStack Spacing="1" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="w-100">
                            Entrar
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/register" Class="w-100">
                            Criar conta
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</MudPopover>

@code {
    private bool _open;
    private bool selectingTenant;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private async Task SelectTenant(Guid tenantId)
    {
        selectingTenant = true;
        try
        {
            await Auth.SelectTenantAsync(tenantId);
        }
        finally
        {
            selectingTenant = false;
            _open = false;
            StateHasChanged();
        }
    }

    private async Task SignOutAll()
    {
        await Auth.SignOutAsync();
        _open = false;
        StateHasChanged();
    }
}
