@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject HealthTech.Front.Services.BffAuthService Auth

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <section class="auth-route-lock">
                        <MudText Typo="Typo.h4">Acesso restrito</MudText>
                        <MudText Typo="Typo.body1">Entre para acessar este modulo.</MudText>
                        <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled">Entrar</MudButton>
                    </section>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Página não encontrada.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override Task OnInitializedAsync()
        => Auth.InitializeAsync();
}
