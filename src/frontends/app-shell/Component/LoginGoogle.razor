@page "/loginGoogle"
@inject HealthTech.AppShell.Services.SupabaseAuthService Auth
@inject IHttpClientFactory HttpClientFactory

@using System.ComponentModel.DataAnnotations

<MudContainer MaxWidth="MaxWidth.False" Class="d-flex justify-center">
    <MudPaper Elevation="0" Class="login-card">
        <MudText Typo="Typo.h5" Class="mb-4">Faça login em sua conta</MudText>

        <!-- OAuth -->
        <MudStack Spacing="1">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="oauth-btn" @onclick="()=>Auth.SignInWithGoogleAsync()">
                <span class="oauth-icon">@((MarkupString)GoogleSvg)</span>
                <span>Continuar com Google</span>
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="oauth-btn" OnClick="@(()=>{})">
                <span class="oauth-icon">@((MarkupString)AppleSvg)</span>
                <span>Continuar com a Apple</span>
            </MudButton>
        </MudStack>

        <!-- Divider "ou" -->
        <MudStack AlignItems="AlignItems.Center">
            <MudDivider />
            <MudText>ou</MudText>
        </MudStack>

        <!-- Form -->
        <EditForm Model="@model" OnValidSubmit="@OnSubmit">
            <DataAnnotationsValidator />
            <MudStack Spacing="1">
                <MudTextField @bind-Value="model.Email" Label="E-mail" For="@(()=>model.Email)" Required="true" />
                <MudTextField @bind-Value="model.Password" Label="Senha" For="@(()=>model.Password)" InputType="InputType.Password" Required="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="w-100">
                    Entrar
                </MudButton>
            </MudStack>

            <div class="forgot-wrap">
                <MudLink Href="#" Underline="Underline.Hover">Esqueceu sua senha?</MudLink>
            </div>
        </EditForm>

        <MudDivider Class="my-6" />

        <div class="signup-wrap">
            <MudText> Ainda não tem conta?
                <MudLink Href="#" Underline="Underline.Hover">Faça seu cadastro!</MudLink>
            </MudText>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private readonly LoginModel model = new();

    private Task OnSubmit()
    {
        // apenas layout – coloque sua lógica aqui
        return Task.CompletedTask;
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }

    // SVGs inline para ícones Google/Apple (mantém visual fiel sem dependências externas)
    private const string GoogleSvg = @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' width='18' height='18'>
