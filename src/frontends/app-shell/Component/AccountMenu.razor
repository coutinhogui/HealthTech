@using Microsoft.AspNetCore.Components.Authorization
@using HealthTech.AppShell.Services
@inject BffAuthService Auth
@implements IDisposable

<MudIconButton @ref="_anchor"
               OnClick="Toggle"
               Size="Size.Small"
               Class="account-trigger">
    @if (!string.IsNullOrEmpty(Auth.AvatarUrl))
    {
        <MudAvatar Size="Size.Medium">
            <MudImage Src="@Auth.AvatarUrl" Alt="@Auth.DisplayName" Elevation="0" />
        </MudAvatar>
    }
    else
    {
        <div class="account-trigger__guest">
            <MudText Typo="Typo.caption">Conta</MudText>
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Medium" />
        </div>
    }
</MudIconButton>

<MudPopover Open="_open"
            AnchorOrigin="Origin.TopRight"
            TransformOrigin="Origin.BottomRight"
            Class="account-popover">
    <AuthorizeView Context="authState">
        <Authorized>
            <MudPaper Elevation="0" Class="account-card">
                <div class="header">
                    <MudAvatar Size="Size.Medium">
                        <MudImage Src="@Auth.AvatarUrl" Alt="@Auth.DisplayName" Elevation="0" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2">@(string.IsNullOrWhiteSpace(Auth.DisplayName) ? "Profissional" : Auth.DisplayName)</MudText>
                    <MudText Color="Color.Secondary" Typo="Typo.caption">@Auth.CurrentUser?.Email</MudText>
                </div>

                <MudDivider Class="my-2" />

                <MudStack Spacing="1">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="w-100"
                               StartIcon="@Icons.Material.Filled.Badge"
                               Href="/">
                        Perfil
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="w-100"
                               StartIcon="@Icons.Material.Filled.Logout"
                               Disabled="@(Auth.CurrentUser is null)"
                               OnClick="@SignOutAll">
                        Sair
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-2" />

                <div class="footer">
                    <MudLink Href="/" Underline="Underline.Hover">Ajuda</MudLink>
                    <MudText>·</MudText>
                    <MudLink Href="/" Underline="Underline.Hover">Suporte</MudLink>
                </div>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            <MudPaper Elevation="0" Class="account-card account-card--guest">
                <MudText Typo="Typo.subtitle2">Acesse sua conta</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Entre para continuar de onde parou.
                </MudText>

                <MudStack Spacing="1" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="w-100">
                        Entrar
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/register" Class="w-100">
                        Criar conta
                    </MudButton>
                </MudStack>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
</MudPopover>

@code {
    private bool _open;
    private MudIconButton? _anchor;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
    }

    private void Toggle() => _open = !_open;

    private async Task SignOutAll()
    {
        await Auth.SignOutAsync();
        _open = false;
        StateHasChanged();
    }
}
