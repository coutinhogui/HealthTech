@inject NavigationManager Nav

<section class="hero-banner">
    <div class="hero-banner__content">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Class="hero-banner__chip">
            Plataforma para clinicas ambulatoriais
        </MudChip>
        <MudText Typo="Typo.h1" Class="hero-banner__title">
            Gestao clinica com cara de produto premium, nao de planilha.
        </MudText>
        <MudText Typo="Typo.subtitle1" Class="hero-banner__subtitle">
            Prontuario, agenda, teleatendimento e financeiro conectados em uma experiencia clara, veloz e confiavel para a equipe inteira.
        </MudText>

        <MudStack Row="true" Spacing="2" Class="hero-banner__actions">
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="@(()=>Nav.NavigateTo("/register"))"
                       StartIcon="@Icons.Material.Filled.NorthEast">
                Iniciar avaliacao
            </MudButton>

            <MudButton Color="Color.Default" Variant="Variant.Outlined"
                       OnClick="@(()=>Nav.NavigateTo("/login"))"
                       StartIcon="@Icons.Material.Filled.LockOpen">
                Entrar na plataforma
            </MudButton>
        </MudStack>

        <div class="hero-banner__trust">
            <span>LGPD-ready</span>
            <span>Ativacao em minutos</span>
            <span>Visao operacional em tempo real</span>
        </div>
    </div>

    <MudPaper Elevation="0" Class="hero-banner__panel">
        <div class="hero-panel__top">
            <span class="hero-panel__kicker">Pulse board</span>
            <MudText Typo="Typo.h6">Turno da manha</MudText>
        </div>

        <div class="hero-panel__grid">
            <div class="hero-metric">
                <strong>92%</strong>
                <span>agenda confirmada</span>
            </div>
            <div class="hero-metric">
                <strong>17 min</strong>
                <span>tempo medio de espera</span>
            </div>
            <div class="hero-metric">
                <strong>+14%</strong>
                <span>receita recorrente</span>
            </div>
            <div class="hero-metric">
                <strong>04</strong>
                <span>alertas acionaveis</span>
            </div>
        </div>

        <div class="hero-panel__timeline">
            <div>
                <span class="timeline-hour">08:30</span>
                <p>Confirmacoes automaticas enviadas para os proximos atendimentos.</p>
            </div>
            <div>
                <span class="timeline-hour">09:10</span>
                <p>Triagem digital finalizada com anexos disponiveis no prontuario.</p>
            </div>
            <div>
                <span class="timeline-hour">10:00</span>
                <p>Repasse parcial atualizado sem retrabalho do financeiro.</p>
            </div>
        </div>
    </MudPaper>
</section>
