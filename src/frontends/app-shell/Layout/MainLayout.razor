@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject HealthTech.AppShell.Services.BffAuthService Auth

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-shell">
    <AuthorizeView Context="authState">
        <Authorized>
            <MudAppBar Elevation="0" Dense="true" Class="app-topbar">
                <MudIconButton Icon="@DrawerButtonIcon"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               aria-label="@DrawerButtonLabel"
                               OnClick="@((e) => DrawerToggle())" />
                <MudLink Href="/" Underline="Underline.None" Class="brand-lockup">
                    <span class="brand-mark">HT</span>
                    <span class="brand-copy">
                        <strong>HealthTech</strong>
                        <small>Operations hub</small>
                    </span>
                </MudLink>
                <MudSpacer />
                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Class="topbar-chip">
                    @(Auth.ActiveTenant?.TenantName ?? "Selecionar clinica")
                </MudChip>
                <HealthTech.AppShell.Component.AccountMenu />
            </MudAppBar>

            <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer">
                <NavMenu />
            </MudDrawer>
        </Authorized>
        <NotAuthorized>
            <MudAppBar Elevation="0" Class="app-topbar">
                <MudLink Href="/" Underline="Underline.None" Class="brand-lockup">
                    <span class="brand-mark">HT</span>
                    <span class="brand-copy">
                        <strong>HealthTech</strong>
                        <small>Practice OS</small>
                    </span>
                </MudLink>
            </MudAppBar>
        </NotAuthorized>
    </AuthorizeView>

    <MudMainContent Class="app-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen = false;
    private MudTheme? _theme;
    private string DrawerButtonIcon => _drawerOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu;
    private string DrawerButtonLabel => _drawerOpen ? "Fechar menu" : "Abrir menu";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#167C80",
        Secondary = "#10211D",
        Tertiary = "#F59E0B",
        Background = "#F4F7F4",
        BackgroundGray = "#EDF3EF",
        Surface = "#FFFFFF",
        AppbarText = "#10211D",
        AppbarBackground = "rgba(244,247,244,0.78)",
        DrawerBackground = "rgba(255,255,255,0.82)",
        DrawerText = "#29413A",
        DrawerIcon = "#167C80",
        TextPrimary = "#10211D",
        TextSecondary = "#60716B",
        Info = "#1D4ED8",
        Success = "#0F9F6E",
        Warning = "#D97706",
        Error = "#DC2626",
        GrayLight = "#D5DFD8",
        GrayLighter = "#EDF3EF",
        LinesDefault = "#DBE5DE",
        TableLines = "#DBE5DE",
        Divider = "#DBE5DE",
        OverlayLight = "#10211D33",
    };

}
