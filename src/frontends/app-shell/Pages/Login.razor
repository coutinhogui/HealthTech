@page "/login"
@inject HealthTech.AppShell.Services.BffAuthService Auth
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Login</PageTitle>

<section class="auth-shell auth-shell--compact">
    <div class="auth-shell__intro">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">Login seguro</MudChip>
        <MudText Typo="Typo.h2" Class="auth-shell__title">Entre para acompanhar pacientes, agenda e receita no mesmo painel.</MudText>
        <MudText Typo="Typo.body1" Class="auth-shell__subtitle">
            A tela de acesso agora segue a mesma linguagem do produto: limpa, confiavel e orientada a fluxo.
        </MudText>
    </div>

    <MudPaper Class="auth-card" Elevation="0">
        <MudText Typo="Typo.h5" GutterBottom>Entrar com e-mail</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Use suas credenciais para acessar o workspace principal.
        </MudText>

        <EditForm Model="@model" OnValidSubmit="@DoLogin">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Email" Label="E-mail" Required="true" Immediate="true" For="@(() => model.Email)" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="model.Password" Label="Senha" InputType="InputType.Password" Required="true" Immediate="true" For="@(() => model.Password)" Variant="Variant.Outlined" />

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@Error</MudAlert>
            }

            <MudStack Row="true" Spacing="2" Class="mt-4 auth-card__actions">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@loading" ButtonType="ButtonType.Submit">
                    @(loading ? "Entrando..." : "Entrar")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/register">
                    Criar conta
                </MudButton>
            </MudStack>

            @if (UserEmail is not null)
            {
                <MudDivider Class="my-4" />
                <MudAlert Severity="Severity.Success">Logado como: <b>@UserEmail</b></MudAlert>
                <MudButton OnClick="@CallProtected" Class="mt-2" Variant="Variant.Outlined">Chamar WhoAmI</MudButton>

                @if (!string.IsNullOrWhiteSpace(ApiResponse))
                {
                    <MudPaper Class="mt-2 pa-3 auth-response">
                        <pre style="white-space: pre-wrap; margin: 0;">@ApiResponse</pre>
                    </MudPaper>
                }
            }
        </EditForm>
    </MudPaper>
</section>

@code {
    private readonly LoginModel model = new();
    private bool loading;
    private string? UserEmail;
    private string? ApiResponse;
    private string? Error;

    private async Task DoLogin()
    {
        Error = null;
        ApiResponse = null;
        loading = true;
        try
        {
            var user = await Auth.SignInAsync(model.Email, model.Password);
            UserEmail = user?.Email;
            if (UserEmail is null)
                Error = "Falha no login. Verifique e-mail/senha.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CallProtected()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("IdentityApi");
            var result = await client.GetStringAsync("api/session");
            ApiResponse = result;
        }
        catch (HttpRequestException ex)
        {
            ApiResponse = $"Erro ao chamar API: {ex.Message}";
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
