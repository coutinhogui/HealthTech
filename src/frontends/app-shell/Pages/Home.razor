@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@code {
    CultureInfo _pt = new("pt-BR");
}
<PageTitle>Home</PageTitle>

@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <AuthorizeView Context="authState">
        <!-- ====================== USUÁRIO AUTENTICADO ====================== -->
        <Authorized>
            @{
                var user = authState?.User;
                var nome = (user?.Identity?.IsAuthenticated ?? false)
                    ? (user?.Identity?.Name ?? "Profissional")
                    : "Profissional";
            }

            <!-- HERO (logado) -->
            <MudPaper Class="pa-6 mb-6 rounded-2xl d-flex align-center justify-space-between" Elevation="2">
                <div>
                    <MudText Typo="Typo.h4" Class="mb-1">Bem-vindo, @nome</MudText>
                    <MudText Typo="Typo.subtitle1" Class="mb-4" Color="Color.Secondary">
                        @DateTimeOffset.Now.ToLocalTime().ToString("dddd, dd 'de' MMMM 'de' yyyy", _pt)
                    </MudText>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(()=>Nav.NavigateTo("/pacientes"))" StartIcon="@Icons.Material.Filled.Group">
                            Pacientes
                        </MudButton>
                        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="@(()=>Nav.NavigateTo("/consultas"))" StartIcon="@Icons.Material.Filled.Event">
                            Consultas
                        </MudButton>
                        <MudButton Color="Color.Info" Variant="Variant.Outlined" OnClick="@(()=>Nav.NavigateTo("/relatorios"))" StartIcon="@Icons.Material.Filled.Assessment">
                            Relatórios
                        </MudButton>
                    </MudStack>
                </div>

                <MudAvatar Size="Size.Large" Class="elevation-3" Color="Color.Primary" Variant="Variant.Filled">
                    @((nome?.Length ?? 0) >= 2 ? nome?.Substring(0,2).ToUpper() : "HT")
                </MudAvatar>
            </MudPaper>

            <!-- KPIs -->
            <MudGrid Class="mb-6">
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="rounded-2xl"><MudCardContent>
                        <MudText Typo="Typo.overline">Pacientes ativos</MudText>
                        <MudText Typo="Typo.h5">@KpiPacientes</MudText>
                        <MudProgressLinear Value="@PacientesPct" Class="mt-2" />
                        <MudText Typo="Typo.caption" Color="Color.Success">+@PacientesDelta% vs. ontem</MudText>
                    </MudCardContent></MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="rounded-2xl"><MudCardContent>
                        <MudText Typo="Typo.overline">Consultas hoje</MudText>
                        <MudText Typo="Typo.h5">@KpiConsultasHoje</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Agenda @AgendaOcupacao% ocupada</MudText>
                    </MudCardContent></MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="rounded-2xl"><MudCardContent>
                        <MudText Typo="Typo.overline">Absenteísmo</MudText>
                        <MudText Typo="Typo.h5">@NoShowRate%</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Error">Meta &lt; 5%</MudText>
                    </MudCardContent></MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="rounded-2xl"><MudCardContent>
                        <MudText Typo="Typo.overline">Receita (mês)</MudText>
                        <MudText Typo="Typo.h5">@ReceitaMes.ToString("C0", _pt)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Success">+@ReceitaDelta% vs. mês passado</MudText>
                    </MudCardContent></MudCard>
                </MudItem>
            </MudGrid>

            <!-- Gráfico (compatível) -->
            <MudPaper Class="pa-4 mb-6 rounded-2xl" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Consultas por semana</MudText>
                <MudChart ChartType="ChartType.Line"
                          Labels="@ChartLabels"
                          Datasets="@ChartValues" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Dados ilustrativos.</MudText>
            </MudPaper>
        </Authorized>

        <!-- ====================== VISITANTE / NÃO AUTENTICADO ====================== -->
        <NotAuthorized>

        <HealthTech.AppShell.Component.HeroBanner/>
            

            <!-- PROVAS SOCIAIS (logos ou selos simples) -->
            <MudPaper Class="pa-4 rounded-2xl mb-8" Elevation="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Escolhido por clínicas e consultórios independentes</MudText>
                <MudStack Row="true" Spacing="4" Class="mt-2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.Vaccines" Size="Size.Large" />
                </MudStack>
            </MudPaper>

            <!-- BENEFÍCIOS / FEATURES -->
            <MudGrid Class="mb-8">
                <MudItem xs="12" md="4">
                    <MudCard Class="h-100 rounded-2xl" Elevation="1">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">Prontuário eletrônico</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            Evoluções estruturadas, anexos, prescrições e CID/DSM. Modelos prontos e campos personalizados.
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Class="h-100 rounded-2xl" Elevation="1">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">Agenda inteligente</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Event" Color="Color.Primary" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            Confirmações automáticas por WhatsApp/SMS, fila de espera, teleconsulta e triagem online.
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Class="h-100 rounded-2xl" Elevation="1">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">Financeiro sem dor</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            Faturamento por convênio, repasses por profissional e indicadores de receita e inadimplência.
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- COMO FUNCIONA -->
            <MudPaper Class="pa-4 rounded-2xl mb-8" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Comece em minutos</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
                        Crie sua conta e configure seu perfil profissional.
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="mr-2" />
                        Importe pacientes (CSV) ou cadastre manualmente.
                    </MudListItem>
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mr-2" />
                        Agende, atenda e acompanhe indicadores em um único painel.
                    </MudListItem>
                </MudList>
            </MudPaper>

            <!-- DEPOIMENTOS -->
            <MudGrid Class="mb-8">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="rounded-2xl h-100">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Filled.FormatQuote" />
                            <MudText Typo="Typo.body1" Class="mt-2">
                                “Reduzi o no-show em 38% usando confirmações automáticas e fila de espera.”
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                — Dra. Carolina, Dermatologia
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="rounded-2xl h-100">
                        <MudCardContent>
                            <MudIcon Icon="@Icons.Material.Filled.FormatQuote" />
                            <MudText Typo="Typo.body1" Class="mt-2">
                                “Faturamento por convênio ficou simples e padronizado — acabou o retrabalho.”
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                — Dr. Felipe, Ortopedia
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- PLANO / PREÇO (CTA) -->
            <MudPaper Class="pa-6 rounded-2xl mb-8" Elevation="2">
                <MudGrid AlignItems="AlignItems.Center">
                    <MudItem xs="12" md="7">
                        <MudText Typo="Typo.h6">Plano Profissional</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Tudo que você precisa para operar o consultório. Sem taxas ocultas.
                        </MudText>
                        <MudList T="string" Dense="true">
                            <MudListItem T="string"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" /> Usuários ilimitados</MudListItem>
                            <MudListItem T="string"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" /> Teleconsulta integrada</MudListItem>
                            <MudListItem T="string"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" /> Relatórios e exportações</MudListItem>
                            <MudListItem T="string"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" /> Suporte por WhatsApp</MudListItem>
                        </MudList>
                    </MudItem>
                    <MudItem xs="12" md="5" Class="d-flex justify-end">
                        <MudPaper Class="pa-4 rounded-2xl text-center" Elevation="1" Style="min-width: 260px;">
                            <MudText Typo="Typo.h4" Class="mb-0">R$ 99<span style="font-size:14px">/mês</span></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">7 dias grátis • cancele quando quiser</MudText>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" Size="Size.Large"
                                    OnClick="@(()=>Nav.NavigateTo("/register"))">
                                Começar agora
                            </MudButton>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- FAQ -->
            <MudPaper Class="pa-4 rounded-2xl mb-10" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Perguntas frequentes</MudText>
                <MudExpansionPanels Elevation="0" Dense="true">
                    <MudExpansionPanel Text="Posso cancelar a qualquer momento?">
                        Sim. O cancelamento é imediato e você não será cobrado no próximo ciclo.
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Há limite de pacientes ou usuários?">
                        Não. O plano profissional inclui pacientes e usuários ilimitados.
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Vocês ajudam a migrar meus dados?">
                        Sim. Oferecemos importação por CSV e suporte para migração assistida.
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>

            <!-- RODAPÉ CTA -->
            <MudPaper Class="pa-6 rounded-2xl" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h6" Class="mb-1">Pronto para simplificar sua rotina?</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Crie sua conta em menos de 2 minutos.</MudText>
                    </div>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                            OnClick="@(()=>Nav.NavigateTo("/register"))">
                        Criar conta grátis
                    </MudButton>
                </MudStack>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>

</MudContainer>

@code {
    // ====== DADOS DE EXEMPLO (substituir por dados reais quando logado) ======
    int KpiPacientes = 1280;
    int PacientesDelta = 3;
    int PacientesPct = 72;

    int KpiConsultasHoje = 42;
    int AgendaOcupacao = 85;

    int NoShowRate = 7;

    decimal ReceitaMes = 183450m;
    int ReceitaDelta = 12;

    // Gráfico compatível (sem MudChartDataset)
    string[] ChartLabels = new[] { "Semana 1", "Semana 2", "Semana 3", "Semana 4" };
    double[][] ChartValues = new[]
    {
        new double[] { 120, 160, 140, 190 }
    };
}
