@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization

@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="home-shell">
    <AuthorizeView Context="authState">
        <Authorized>
            @{
                var user = authState?.User;
                var nome = (user?.Identity?.IsAuthenticated ?? false)
                    ? (user?.Identity?.Name ?? "Profissional")
                    : "Profissional";
            }

            <section class="dashboard-hero">
                <div class="dashboard-hero__copy">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">Painel operacional</MudChip>
                    <MudText Typo="Typo.h2" Class="dashboard-hero__title">Bem-vindo, @nome</MudText>
                    <MudText Typo="Typo.subtitle1" Class="dashboard-hero__subtitle">
                        @DateTimeOffset.Now.ToLocalTime().ToString("dddd, dd 'de' MMMM 'de' yyyy", _pt)
                    </MudText>
                    <MudText Typo="Typo.body1" Class="dashboard-hero__body">
                        O workspace agora destaca o que precisa de acao rapida: ritmo da agenda, gargalos e impacto financeiro.
                    </MudText>

                    <MudStack Row="true" Spacing="2" Class="dashboard-hero__actions">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="#operacoes" StartIcon="@Icons.Material.Filled.NorthEast">
                            Ver operacoes
                        </MudButton>
                        <MudButton Color="Color.Default" Variant="Variant.Outlined" Href="#metricas" StartIcon="@Icons.Material.Filled.QueryStats">
                            Explorar metricas
                        </MudButton>
                    </MudStack>
                </div>

                <MudPaper Elevation="0" Class="dashboard-hero__panel">
                    <div class="dashboard-hero__panel-row">
                        <span>Agenda confirmada</span>
                        <strong>92%</strong>
                    </div>
                    <div class="dashboard-hero__panel-row">
                        <span>Atendimentos em risco</span>
                        <strong>04</strong>
                    </div>
                    <div class="dashboard-hero__panel-row">
                        <span>Receita projetada</span>
                        <strong>@ReceitaMes.ToString("C0", _pt)</strong>
                    </div>
                </MudPaper>
            </section>

            <MudGrid Class="kpi-grid">
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="kpi-card" Elevation="0">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Pacientes ativos</MudText>
                            <MudText Typo="Typo.h5">@KpiPacientes</MudText>
                            <MudProgressLinear Value="@PacientesPct" Class="mt-2" />
                            <MudText Typo="Typo.caption" Color="Color.Success">+@PacientesDelta% vs. ontem</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="kpi-card" Elevation="0">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Consultas hoje</MudText>
                            <MudText Typo="Typo.h5">@KpiConsultasHoje</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Agenda @AgendaOcupacao% ocupada</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="kpi-card" Elevation="0">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Absenteismo</MudText>
                            <MudText Typo="Typo.h5">@NoShowRate%</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">Meta &lt; 5%</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Class="kpi-card" Elevation="0">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Receita do mes</MudText>
                            <MudText Typo="Typo.h5">@ReceitaMes.ToString("C0", _pt)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Success">+@ReceitaDelta% vs. mes passado</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <MudGrid Class="dashboard-sections">
                <MudItem xs="12" lg="8" id="metricas">
                    <MudPaper Class="surface-card surface-card--chart" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-1">Consultas por semana</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
                            Tendencia consolidada para leitura rapida da operacao.
                        </MudText>
                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@ChartSeries"
                                  XAxisLabels="@ChartLabels" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="4">
                    <MudPaper Class="surface-card surface-card--list" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3">Alertas acionaveis</MudText>
                        <div class="insight-list">
                            <div class="insight-list__item">
                                <strong>Retornos pendentes</strong>
                                <span>12 pacientes sem reagendamento nos ultimos 30 dias.</span>
                            </div>
                            <div class="insight-list__item">
                                <strong>Fila de espera</strong>
                                <span>3 encaixes possiveis para preencher lacunas de hoje.</span>
                            </div>
                            <div class="insight-list__item">
                                <strong>Financeiro</strong>
                                <span>2 repasses aguardando conciliacao ate o fim do turno.</span>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudGrid Class="dashboard-sections" id="operacoes">
                <MudItem xs="12" md="4">
                    <MudPaper Class="surface-card module-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Pacientes</MudText>
                        <MudText Typo="Typo.body2">Historico clinico, anexos e proximas acoes com leitura objetiva.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="surface-card module-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Agenda</MudText>
                        <MudText Typo="Typo.body2">Blocos claros para equipe, encaixes e confirmacoes automaticas.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4" id="planos">
                    <MudPaper Class="surface-card module-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Receita</MudText>
                        <MudText Typo="Typo.body2">Indicadores financeiros com menos ruido visual e mais prioridade real.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </Authorized>

        <NotAuthorized>
            <HealthTech.AppShell.Component.HeroBanner />

            <section class="trust-strip">
                <span>Escolhido por consultorios independentes, policlinicas e operacoes em crescimento.</span>
                <div>
                    <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Size="Size.Large" />
                    <MudIcon Icon="@Icons.Material.Filled.Vaccines" Size="Size.Large" />
                </div>
            </section>

            <MudGrid Class="feature-grid">
                <MudItem xs="12" md="4">
                    <MudPaper Class="surface-card feature-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Prontuario com contexto</MudText>
                        <MudText Typo="Typo.body2">
                            Evolucoes, anexos e prescricoes organizados em blocos claros, sem cara de sistema legado.
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="surface-card feature-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Agenda inteligente</MudText>
                        <MudText Typo="Typo.body2">
                            Confirmacoes automaticas, fila de espera e teleatendimento alinhados ao ritmo da clinica.
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="surface-card feature-card" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Financeiro com leitura rapida</MudText>
                        <MudText Typo="Typo.body2">
                            Repasse, faturamento e indicadores em paineis que priorizam decisao, nao ruido.
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <section class="story-grid">
                <MudPaper Class="surface-card story-card" Elevation="0">
                    <MudText Typo="Typo.h5">Comece em minutos</MudText>
                    <div class="story-steps">
                        <div><strong>01</strong><span>Crie sua conta e configure o perfil da equipe.</span></div>
                        <div><strong>02</strong><span>Importe pacientes ou comece do zero com formularios limpos.</span></div>
                        <div><strong>03</strong><span>Acompanhe agenda, atendimento e receita em um mesmo fluxo.</span></div>
                    </div>
                </MudPaper>

                <MudPaper Class="surface-card quote-card" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.FormatQuote" />
                    <MudText Typo="Typo.h5">
                        "Reduzimos no-show e retrabalho porque a operacao finalmente ficou legivel."
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Dra. Carolina, dermatologia
                    </MudText>
                </MudPaper>
            </section>

            <MudPaper Class="pricing-banner" Elevation="0">
                <div>
                    <MudText Typo="Typo.h4">Plano profissional para clinicas que querem crescer com mais clareza.</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        Teleconsulta integrada, usuarios ilimitados, relatorios e suporte proximo.
                    </MudText>
                </div>
                <div class="pricing-banner__card">
                    <MudText Typo="Typo.h3">R$ 99</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">por mes, com 7 dias gratis</MudText>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" Size="Size.Large"
                               OnClick="@(()=>Nav.NavigateTo("/register"))">
                        Comecar agora
                    </MudButton>
                </div>
            </MudPaper>

            <MudPaper Class="surface-card faq-card" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-3">Perguntas frequentes</MudText>
                <MudExpansionPanels Elevation="0" Dense="true" Class="faq-panels">
                    <MudExpansionPanel Text="Posso cancelar a qualquer momento?">
                        Sim. O cancelamento e imediato e voce nao sera cobrado no proximo ciclo.
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Ha limite de pacientes ou usuarios?">
                        Nao. O plano profissional inclui pacientes e usuarios ilimitados.
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Voces ajudam a migrar meus dados?">
                        Sim. Oferecemos importacao por CSV e suporte para migracao assistida.
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>

            <MudPaper Class="footer-cta" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.h6" Class="mb-1">Pronto para simplificar sua rotina?</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Ative sua conta e experimente a nova camada visual do produto.</MudText>
                    </div>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                               OnClick="@(()=>Nav.NavigateTo("/register"))">
                        Criar conta gratis
                    </MudButton>
                </MudStack>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    private readonly CultureInfo _pt = new("pt-BR");

    private const int KpiPacientes = 1280;
    private const int PacientesDelta = 3;
    private const int PacientesPct = 72;
    private const int KpiConsultasHoje = 42;
    private const int AgendaOcupacao = 85;
    private const int NoShowRate = 7;
    private const decimal ReceitaMes = 183450m;
    private const int ReceitaDelta = 12;

    private readonly string[] ChartLabels = ["Semana 1", "Semana 2", "Semana 3", "Semana 4"];
    private readonly List<ChartSeries> ChartSeries =
    [
        new() { Name = "Consultas", Data = [120, 160, 140, 190] }
    ];
}
