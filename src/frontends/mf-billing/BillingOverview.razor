@namespace HealthTech.Frontends.MfBilling
@inject BillingBffClient BillingClient
@inject BillingPatientOptionsClient PatientsClient
@inject BillingAppointmentOptionsClient AppointmentsClient

<section class="mf-shell">
    <header class="mf-header">
        <div>
            <h2>Financeiro</h2>
            <p>Cobrancas reais por tenant, com fechamento simples de lote mensal.</p>
        </div>
        <button type="button" @onclick="CloseCurrentBatchAsync" disabled="@Saving">Fechar competencia</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="mf-alert @StatusClass">@StatusMessage</div>
    }

    <div class="mf-filters">
        <select @bind="StatusFilter" @bind:after="LoadChargesAsync">
            <option value="">Todos os status</option>
            <option value="open">Em aberto</option>
            <option value="paid">Pago</option>
            <option value="batched">Em lote</option>
            <option value="overdue">Em atraso</option>
        </select>
        <select @bind="PayerFilter">
            <option value="all">Todos os pagadores</option>
            <option value="insurance">Convenio</option>
            <option value="private">Particular</option>
        </select>
    </div>

    <form class="mf-form" @onsubmit="CreateChargeAsync" @onsubmit:preventDefault>
        <label>
            Consulta
            <select @bind="NewCharge.AppointmentId">
                <option value="">Selecione</option>
                @foreach (var item in Appointments)
                {
                    <option value="@item.Id">@item.StartsAtUtc.ToLocalTime().ToString("dd/MM HH:mm") - @item.Status</option>
                }
            </select>
        </label>
        <label>
            Paciente
            <select @bind="NewCharge.PatientId">
                <option value="">Selecione</option>
                @foreach (var patient in Patients)
                {
                    <option value="@patient.Id">@patient.FullName</option>
                }
            </select>
        </label>
        <label>
            Pagador
            <select @bind="NewCharge.PayerType">
                <option value="insurance">Convenio</option>
                <option value="private">Particular</option>
            </select>
        </label>
        <label>
            Valor
            <input type="number" step="0.01" min="0.01" @bind="NewCharge.Amount" />
        </label>
        <label>
            Vencimento
            <input type="date" value="@NewCharge.DueDate" @onchange="UpdateDueDate" />
        </label>
        <label>
            Descricao
            <input @bind="NewCharge.Description" placeholder="Consulta ambulatorial" />
        </label>
        <button type="submit" disabled="@Saving">@(Saving ? "Salvando..." : "Criar cobranca")</button>
    </form>

    <div class="mf-kpis">
        <article>
            <strong>@FilteredCharges.Sum(c => c.Amount).ToString("C2", PtBr)</strong>
            <span>Total no filtro</span>
        </article>
        <article>
            <strong>@FilteredCharges.Where(c => c.Status == "open" || c.Status == "overdue").Sum(c => c.Amount).ToString("C2", PtBr)</strong>
            <span>Em aberto</span>
        </article>
        <article>
            <strong>@Batches.Count</strong>
            <span>Lotes fechados</span>
        </article>
    </div>

    <div class="mf-list">
        <div class="mf-list__head">
            <span>Cobranca</span>
            <span>Status</span>
            <span>Valor</span>
            <span>Acoes</span>
        </div>
        @foreach (var item in FilteredCharges)
        {
            <div class="mf-list__row">
                <div>
                    <strong>@item.Description</strong>
                    <p>@ResolvePatientName(item.PatientId) · venc. @item.DueDate.ToString("dd/MM/yyyy") · @ToPayerLabel(item.PayerType)</p>
                </div>
                <span class="@($"status-{item.Status.ToLowerInvariant()}")">@item.Status</span>
                <span>@item.Amount.ToString("C2", PtBr)</span>
                <span>
                    @if (item.Status is "open" or "overdue")
                    {
                        <button type="button" @onclick="() => MarkPaidAsync(item.Id)" disabled="@Saving">Marcar pago</button>
                    }
                </span>
            </div>
        }
    </div>
</section>

@code {
    private readonly System.Globalization.CultureInfo PtBr = new("pt-BR");
    private bool Loading { get; set; }
    private bool Saving { get; set; }
    private string? StatusMessage { get; set; }
    private string StatusClass { get; set; } = "mf-alert--info";
    private string StatusFilter { get; set; } = "";
    private string PayerFilter { get; set; } = "all";
    private List<BillingChargeDto> Charges { get; set; } = [];
    private List<BillingBatchDto> Batches { get; set; } = [];
    private List<BillingPatientDto> Patients { get; set; } = [];
    private List<BillingAppointmentDto> Appointments { get; set; } = [];
    private NewChargeForm NewCharge { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
        await LoadChargesAsync();
        await LoadBatchesAsync();
    }

    private IEnumerable<BillingChargeDto> FilteredCharges =>
        Charges.Where(charge => PayerFilter == "all" || charge.PayerType == PayerFilter);

    private async Task LoadOptionsAsync()
    {
        Patients = (await PatientsClient.ListAsync(CancellationToken.None)).ToList();
        Appointments = (await AppointmentsClient.ListAsync(CancellationToken.None))
            .Where(a => a.Status is "scheduled" or "confirmed" or "completed")
            .Take(200)
            .ToList();
        NewCharge.PatientId = Patients.FirstOrDefault()?.Id.ToString("D") ?? "";
        NewCharge.AppointmentId = Appointments.FirstOrDefault()?.Id.ToString("D") ?? "";
    }

    private async Task LoadChargesAsync()
    {
        Loading = true;
        StatusMessage = null;
        try
        {
            Charges = (await BillingClient.ListChargesAsync(StatusFilter, CancellationToken.None)).ToList();
        }
        catch
        {
            Charges = [];
            StatusClass = "mf-alert--error";
            StatusMessage = "Nao foi possivel carregar cobrancas.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadBatchesAsync()
    {
        try
        {
            Batches = (await BillingClient.ListBatchesAsync(CancellationToken.None)).ToList();
        }
        catch
        {
            Batches = [];
        }
    }

    private void UpdateDueDate(ChangeEventArgs args)
        => NewCharge.DueDate = args.Value?.ToString() ?? "";

    private async Task CreateChargeAsync()
    {
        Saving = true;
        StatusMessage = null;
        try
        {
            if (!Guid.TryParse(NewCharge.AppointmentId, out var appointmentId) ||
                !Guid.TryParse(NewCharge.PatientId, out var patientId) ||
                !DateOnly.TryParse(NewCharge.DueDate, out var dueDate))
            {
                StatusClass = "mf-alert--error";
                StatusMessage = "Selecione consulta, paciente e vencimento.";
                return;
            }

            var result = await BillingClient.CreateChargeAsync(
                new CreateBillingChargeDto(
                    appointmentId,
                    patientId,
                    NewCharge.PayerType,
                    NewCharge.Description,
                    NewCharge.Amount,
                    dueDate),
                CancellationToken.None);

            if (!result.Success)
            {
                StatusClass = "mf-alert--error";
                StatusMessage = result.Message ?? "Nao foi possivel criar cobranca.";
                return;
            }

            StatusClass = "mf-alert--success";
            StatusMessage = "Cobranca criada.";
            NewCharge.Reset(Patients.FirstOrDefault()?.Id, Appointments.FirstOrDefault()?.Id);
            await LoadChargesAsync();
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task MarkPaidAsync(Guid chargeId)
    {
        Saving = true;
        StatusMessage = null;
        try
        {
            var result = await BillingClient.MarkChargeAsPaidAsync(chargeId, CancellationToken.None);
            if (!result.Success)
            {
                StatusClass = "mf-alert--error";
                StatusMessage = result.Message ?? "Nao foi possivel atualizar cobranca.";
                return;
            }

            StatusClass = "mf-alert--success";
            StatusMessage = "Cobranca marcada como paga.";
            await LoadChargesAsync();
            await LoadBatchesAsync();
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task CloseCurrentBatchAsync()
    {
        Saving = true;
        StatusMessage = null;
        try
        {
            var currentMonth = new DateOnly(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
            var result = await BillingClient.CloseBatchAsync(currentMonth, CancellationToken.None);
            if (!result.Success)
            {
                StatusClass = "mf-alert--error";
                StatusMessage = result.Message ?? "Nao foi possivel fechar lote.";
                return;
            }

            StatusClass = "mf-alert--success";
            StatusMessage = "Lote da competencia fechado.";
            await LoadChargesAsync();
            await LoadBatchesAsync();
        }
        finally
        {
            Saving = false;
        }
    }

    private string ResolvePatientName(Guid patientId)
        => Patients.FirstOrDefault(p => p.Id == patientId)?.FullName ?? patientId.ToString("D");

    private static string ToPayerLabel(string payerType)
        => payerType == "insurance" ? "Convenio" : "Particular";

    private sealed class NewChargeForm
    {
        public string AppointmentId { get; set; } = "";
        public string PatientId { get; set; } = "";
        public string PayerType { get; set; } = "insurance";
        public string Description { get; set; } = "Consulta";
        public decimal Amount { get; set; } = 180m;
        public string DueDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow.Date.AddDays(15)).ToString("yyyy-MM-dd");

        public void Reset(Guid? patientId, Guid? appointmentId)
        {
            AppointmentId = appointmentId?.ToString("D") ?? "";
            PatientId = patientId?.ToString("D") ?? "";
            PayerType = "insurance";
            Description = "Consulta";
            Amount = 180m;
            DueDate = DateOnly.FromDateTime(DateTime.UtcNow.Date.AddDays(15)).ToString("yyyy-MM-dd");
        }
    }
}
