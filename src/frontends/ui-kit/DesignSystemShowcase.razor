@namespace HealthTech.Frontends.UiKit

<section class="kit-shell">
    <header>
        <h2>HealthTech UI Kit</h2>
        <p>Base de cores, tipografia e componentes de acao para os micro-frontends.</p>
    </header>

    <div class="swatches">
        <article><span class="s-1"></span><strong>Primary</strong><small>#167C80</small></article>
        <article><span class="s-2"></span><strong>Ink</strong><small>#10211D</small></article>
        <article><span class="s-3"></span><strong>Success</strong><small>#0F9F6E</small></article>
        <article><span class="s-4"></span><strong>Warning</strong><small>#D97706</small></article>
        <article><span class="s-5"></span><strong>Error</strong><small>#DC2626</small></article>
    </div>

    <div class="controls">
        <button class="btn-primary" type="button">Acao primaria</button>
        <button class="btn-secondary" type="button">Acao secundaria</button>
        <button class="btn-ghost" type="button">Acao neutra</button>
    </div>
</section>
