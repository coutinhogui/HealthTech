{
  "ReverseProxy": {
    "Routes": {
      "patients": {
        "ClusterId": "patients",
        "Match": { "Path": "/patients/{**catch-all}" }
      }
    },
    "Clusters": {
      "patients": {
        "Destinations": {
          "d1": { "Address": "http://patients-api/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
